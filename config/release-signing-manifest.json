{
  "schemaVersion": 1,
  "releaseScope": "HydraSeat v1 owned end-user release artifacts plus the bounded Qt 6.8.3 runtime deployed by windeployqt; tests, probes, labs, unrelated third-party binaries, and drivers are excluded.",
  "artifacts": [
    {
      "id": "main-ui",
      "kind": "cmake-executable",
      "target": "HydraSeat",
      "fileName": "HydraSeat.exe",
      "architectures": ["x64"]
    },
    {
      "id": "host",
      "kind": "cmake-executable",
      "target": "hydra_host",
      "fileName": "hydra_host.exe",
      "architectures": ["x64"]
    },
    {
      "id": "xinput-adapter",
      "kind": "cmake-shared-library",
      "target": "hydra_xinput_adapter",
      "fileName": "hydra_xinput_adapter.dll",
      "architectures": ["x64"]
    },
    {
      "id": "gate-c-adapter",
      "kind": "cmake-shared-library",
      "target": "hydra_gate_c_adapter",
      "fileName": "hydra_gate_c_adapter.dll",
      "architectures": ["x64"]
    },
    {
      "id": "gate-c-shim",
      "kind": "cmake-shared-library",
      "target": "hydra_gate_c_shim",
      "fileName": "hydra_gate_c_shim.dll",
      "architectures": ["x64"]
    },
    {
      "id": "gate-c-external-bridge",
      "kind": "cmake-shared-library",
      "target": "hydra_gate_c_external_bridge",
      "fileName": "hydra_gate_c_external_bridge.dll",
      "architectures": ["x64"]
    },
    {
      "id": "watchdog",
      "kind": "cmake-executable",
      "target": "hydra_watchdog",
      "fileName": "hydra_watchdog.exe",
      "architectures": ["x64"]
    },
    {
      "id": "reset",
      "kind": "cmake-executable",
      "target": "hydra_reset",
      "fileName": "hydra_reset.exe",
      "architectures": ["x64"]
    },
    {
      "id": "profile-cli",
      "kind": "cmake-executable",
      "target": "hydraseat_profilectl",
      "fileName": "hydraseat_profilectl.exe",
      "architectures": ["x64"]
    },
    {
      "id": "community-validator",
      "kind": "cmake-executable",
      "target": "hydraseat_community_validate",
      "fileName": "hydraseat_community_validate.exe",
      "architectures": ["x64"]
    },
    {
      "id": "installer-script",
      "kind": "powershell-script",
      "sourcePath": "tools/install_hydraseat.ps1",
      "fileName": "install_hydraseat.ps1",
      "architectures": ["x64"]
    }
  ],
  "excludedArtifactClasses": [
    "test executables",
    "diagnostic/lab/probe tools not in the end-user package",
    "third-party binaries other than the reviewed Qt 6.8.3 runtime",
    "drivers until a separately reviewed signed driver artifact is selected"
  ]
}
